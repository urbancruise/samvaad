generator client {
  provider      = "prisma-client-js"
  output        = "../../generated/postgres-client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_DATABASE_URL")
}

enum HierarchyLevel {
  ADMIN
  HOD
  MANAGER
  TEAM_LEAD
  EMPLOYEE
}

enum GoalType {
  LONG_TERM
  ONGOING
  URGENT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GoalStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActivityStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PerformancePeriod {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RewardType {
  BADGE
  CERTIFICATE
  BONUS
  CASH
  GIFT
  APPRECIATION
}

enum RewardStatus {
  PENDING
  ISSUED
  CANCELLED
}

enum AchievementLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}


model RoleLevelMap {
  id          String         @id @default(cuid())
  mysqlRoleId Int            @unique // matches `roles.id` in MySQL
  roleName    String // cached label, e.g. "SEO Executive"
  level       HierarchyLevel

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id String @id @default(cuid())

  userId Int // MySQL users.id — no relation, cross-database

  title   String
  message String
  type    String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isRead])
}

model Goal {
  id String @id @default(cuid())

  title       String
  description String?

  goalType GoalType
  priority Priority   @default(MEDIUM)
  status   GoalStatus @default(PENDING)

  progress Int @default(0)

  startDate DateTime
  dueDate   DateTime

  createdById  Int // MySQL users.id
  assignedToId Int // MySQL users.id

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([goalType])
  @@index([startDate])
  @@index([dueDate])
  @@index([assignedToId, status])
}

model Task {
  id String @id @default(cuid())

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  title       String
  description String?

  priority Priority   @default(MEDIUM)
  status   TaskStatus @default(PENDING)

  progress Int @default(0)

  estimatedHours Float?

  startDate   DateTime
  dueDate     DateTime
  completedAt DateTime?

  createdById  Int // MySQL users.id
  assignedToId Int // MySQL users.id

  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goalId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([startDate])
  @@index([dueDate])
  @@index([assignedToId, status])
}

model Activity {
  id String @id @default(cuid())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  title       String
  description String?

  priority Priority       @default(MEDIUM)
  status   ActivityStatus @default(PENDING)

  progress Int @default(0)

  startedAt DateTime?

  completedAt      DateTime?
  estimatedMinutes Int?

  actualMinutes Int @default(0)

  pausedAt  DateTime?
  resumedAt DateTime?

  totalPauseMinutes Int @default(0)

  startDate DateTime  @default(now())
  dueDate   DateTime?

  createdById  Int // MySQL users.id
  assignedToId Int // MySQL users.id

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  history   ActivityHistory[]

  @@index([taskId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([startDate])
  @@index([dueDate])
  @@index([assignedToId, status])
}

model ActivityHistory {
  id String @id @default(cuid())

  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  userId Int // MySQL users.id

  action  String
  remarks String?

  oldValue Json?
  newValue Json?

  createdAt DateTime @default(now())
}

model Performance {
  id String @id @default(cuid())

  userId Int // MySQL users.id

  period PerformancePeriod

  startDate DateTime
  endDate   DateTime

  totalGoals     Int @default(0)
  completedGoals Int @default(0)

  totalTasks     Int @default(0)
  completedTasks Int @default(0)

  totalActivities     Int @default(0)
  completedActivities Int @default(0)

  completionRate Float @default(0)

  productivityScore Float @default(0)
  qualityScore      Float @default(0)

  performanceScore Float @default(0)

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rewards Reward[]

  @@unique([userId, period, startDate], name: "userId_period_startDate")
  @@index([userId])
  @@index([period])
}

model Achievement {
  id String @id @default(cuid())

  userId Int // MySQL users.id

  title       String
  description String?
  badge       String

  level  AchievementLevel
  points Int              @default(0)

  unlockedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, badge])
  @@index([userId])
}

model Reward {
  id String @id @default(cuid())

  userId Int // MySQL users.id

  performanceId String?
  performance   Performance? @relation(fields: [performanceId], references: [id], onDelete: SetNull)

  title       String
  description String?
  badge       String?

  rewardType RewardType
  status     RewardStatus @default(PENDING)

  amount Decimal? @db.Decimal(10, 2)
  points Int      @default(0)

  issuedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}



model Rating {
  id        String @id @default(cuid())

  // Both are MySQL user ids — no FK relation across DBs, same pattern
  // as every other cross-DB reference in this app (Goal/Task/Activity).
  employeeId Int   // the person being rated
  raterId    Int   // whoever actually submitted this row

  raterType RaterType // SELF | SENIOR — exactly 2 rows per employee per period

  period String // "YYYY-MM", e.g. "2026-07"

  // Snapshot of department at time of rating (not a live FK) — so
  // department-filtered history stays accurate even if someone
  // transfers departments later.
  departmentId Int?

  salesScore        Int? // 1-5
  conductScore      Int? // 1-5
  contributionScore Int? // 1-5

  achievementPercent Float?

  // Department-specific text fields (e.g. "Sales Improvement Ideas" for
  // Sales, something else for other departments) — see
  // rating.fieldConfig.js on the backend for the per-department key
  // list. Stored as a flexible JSON blob rather than fixed columns
  // since the field set varies by department and is meant to be easy
  // to extend without a migration each time.
  extraFields Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Exactly one SELF row and one SENIOR row per employee per period.
  @@unique([employeeId, raterType, period])
  @@index([employeeId, period])
  @@index([departmentId, period])
}

enum RaterType {
  SELF
  SENIOR
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  SYSTEM
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model Conversation {
  id String @id @default(cuid())

  type ConversationType

  title String?

  imageUrl String?

  createdBy Int

  lastMessageId String?

  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members ConversationMember[]

  messages Message[]

  @@index([createdBy])
  @@index([lastMessageAt])
}

model ConversationMember {
  id String @id @default(cuid())

  conversationId String
  conversation Conversation
    @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId Int

  joinedAt DateTime @default(now())

  leftAt DateTime?

  isMuted Boolean @default(false)

  isPinned Boolean @default(false)

  lastReadMessageId String?

  lastReadAt DateTime?

  createdAt DateTime @default(now())

  @@unique([conversationId, userId])

  @@index([userId])

  @@index([conversationId])
}

model Message {
  id String @id @default(cuid())

  conversationId String

  conversation Conversation
    @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId Int

  type MessageType @default(TEXT)

  content String?

  attachmentUrl String?

  attachmentName String?

  attachmentSize Int?

  mimeType String?

  replyToId String?

  editedAt DateTime?

  deletedForEveryone Boolean @default(false)

  status MessageStatus @default(SENT)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([conversationId])

  @@index([senderId])

  @@index([createdAt])

  @@index([replyToId])
}

model MessageRead {
  id String @id @default(cuid())

  messageId String

  userId Int

  readAt DateTime @default(now())

  @@unique([messageId, userId])

  @@index([userId])

  @@index([messageId])
}

model MessageDelete {
  id String @id @default(cuid())

  messageId String

  userId Int

  deletedAt DateTime @default(now())

  @@unique([messageId, userId])

  @@index([userId])

  @@index([messageId])
}