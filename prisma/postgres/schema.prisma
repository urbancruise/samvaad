generator client {
  provider      = "prisma-client-js"
  output        = "../../generated/postgres-client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_DATABASE_URL")
  directUrl = env("POSTGRES_DIRECT_URL")
}
enum HierarchyLevel {
  ADMIN
  HOD
  MANAGER
  TEAM_LEAD
  EMPLOYEE
}

enum GoalType {
  LONG_TERM
  ONGOING
  URGENT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GoalStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActivityStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PerformancePeriod {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RewardType {
  BADGE
  CERTIFICATE
  BONUS
  CASH
  GIFT
  APPRECIATION
}

enum RewardStatus {
  PENDING
  ISSUED
  CANCELLED
}

enum AchievementLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}


model RoleLevelMap {
  id          String         @id @default(cuid())
  mysqlRoleId Int            @unique // matches `roles.id` in MySQL
  roleName    String // cached label, e.g. "SEO Executive"
  level       HierarchyLevel

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id String @id @default(cuid())

  userId Int // MySQL users.id — no relation, cross-database

  title   String
  message String
  type    String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
   link String?

  @@index([userId])
  @@index([userId, isRead])
}

// ============================================
// Add to your Notification model in schema.prisma (Postgres), then:
//   npx prisma migrate dev --name add-notification-link --schema=prisma/postgres/schema.prisma
//
// If your Notification model already has different field names,
// adjust notification.service.js/repository.js below to match —
// this assumes the shape used earlier in this conversation:
// id, userId, title, message, type, isRead, createdAt.
// ============================================

// model Notification {
  // ...your existing fields (id, userId, title, message, type, isRead, createdAt)...

  // New: where clicking this notification should navigate. Stored as
  // a role-agnostic relative path (e.g. "/email/thread/abc123") —
  // the frontend prepends the current user's role prefix
  // (/employee, /teamlead, etc.) at click time, same pattern used
  // for Calendar event links and Task/Activity card links elsewhere
  // in this app.
 
// }


model Goal {
  id String @id @default(cuid())

  title       String
  description String?

  goalType GoalType
  priority Priority   @default(MEDIUM)
  status   GoalStatus @default(PENDING)

  progress Int @default(0)

  startDate DateTime
  dueDate   DateTime

  createdById  Int // MySQL users.id
  assignedToId Int // MySQL users.id

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([goalType])
  @@index([startDate])
  @@index([dueDate])
  @@index([assignedToId, status])
}

model Task {
  id String @id @default(cuid())

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  title       String
  description String?

  priority Priority   @default(MEDIUM)
  status   TaskStatus @default(PENDING)

  progress Int @default(0)

  estimatedHours Float?

  startDate   DateTime
  dueDate     DateTime
  completedAt DateTime?

  createdById  Int // MySQL users.id
  assignedToId Int // MySQL users.id

  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goalId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([startDate])
  @@index([dueDate])
  @@index([assignedToId, status])
}

model Activity {
  id String @id @default(cuid())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  title       String
  description String?

  priority Priority       @default(MEDIUM)
  status   ActivityStatus @default(PENDING)

  progress Int @default(0)

  startedAt DateTime?

  completedAt      DateTime?
  estimatedMinutes Int?

  actualMinutes Int @default(0)

  pausedAt  DateTime?
  resumedAt DateTime?

  totalPauseMinutes Int @default(0)

  startDate DateTime  @default(now())
  dueDate   DateTime?

  createdById  Int // MySQL users.id
  assignedToId Int // MySQL users.id

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  history   ActivityHistory[]

  @@index([taskId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([startDate])
  @@index([dueDate])
  @@index([assignedToId, status])
}

model ActivityHistory {
  id String @id @default(cuid())

  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  userId Int // MySQL users.id

  action  String
  remarks String?

  oldValue Json?
  newValue Json?

  createdAt DateTime @default(now())
}

model Performance {
  id String @id @default(cuid())

  userId Int // MySQL users.id

  period PerformancePeriod

  startDate DateTime
  endDate   DateTime

  totalGoals     Int @default(0)
  completedGoals Int @default(0)

  totalTasks     Int @default(0)
  completedTasks Int @default(0)

  totalActivities     Int @default(0)
  completedActivities Int @default(0)

  completionRate Float @default(0)

  productivityScore Float @default(0)
  qualityScore      Float @default(0)

  performanceScore Float @default(0)

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rewards Reward[]

  @@unique([userId, period, startDate], name: "userId_period_startDate")
  @@index([userId])
  @@index([period])
}

model Achievement {
  id String @id @default(cuid())

  userId Int // MySQL users.id

  title       String
  description String?
  badge       String

  level  AchievementLevel
  points Int              @default(0)

  unlockedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, badge])
  @@index([userId])
}

model Reward {
  id String @id @default(cuid())

  userId Int // MySQL users.id

  performanceId String?
  performance   Performance? @relation(fields: [performanceId], references: [id], onDelete: SetNull)

  title       String
  description String?
  badge       String?

  rewardType RewardType
  status     RewardStatus @default(PENDING)

  amount Decimal? @db.Decimal(10, 2)
  points Int      @default(0)

  issuedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}



model Rating {
  id        String @id @default(cuid())

  employeeId Int  
  raterId    Int  

  raterType RaterType 
  period String 

  departmentId Int?

  salesScore        Int? 
  conductScore      Int? 
  contributionScore Int? 
  achievementPercent Float?

  extraFields Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, raterType, period])
  @@index([employeeId, period])
  @@index([departmentId, period])
}

enum RaterType {
  SELF
  SENIOR
}

// ============================================
// Append to prisma/postgres/schema.prisma, then:
//   npx prisma migrate dev --name add-email --schema=prisma/postgres/schema.prisma
// ============================================

model EmailThread {
  id             String   @id @default(cuid())
  subject        String
  lastActivityAt DateTime @default(now())

  emails Email[]

  @@index([lastActivityAt])
}

model Email {
  id       String @id @default(cuid())
  threadId String

  fromId Int // MySQL user id — sender

  subject  String
  bodyHtml String @db.Text
  bodyText String? @db.Text // plain-text fallback, used for search/preview

  isDraft     Boolean   @default(false)
  scheduledAt DateTime? // Schedule Send — a background dispatcher flips isDraft/sentAt when due
  sentAt      DateTime?

  // Reply/Reply-All/Forward chain — null for the first email in a thread
  inReplyToId String?

  // For Schedule Send only — the intended {to, cc, bcc} user-id lists,
  // held here until the dispatcher actually sends it (at which point
  // real EmailRecipient rows get created and this is cleared). Not
  // used for anything already sent.
  pendingRecipients Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread      EmailThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  recipients  EmailRecipient[]
  attachments EmailAttachment[]

  @@index([fromId])
  @@index([threadId])
  @@index([scheduledAt])
}

/**
 * One row per (email, person, role) — this is the per-mailbox state.
 * The SENDER gets a row too (type SENDER, folder SENT), so "delete
 * from my Sent folder" never touches the recipient's Inbox copy, and
 * vice versa — same as real email/IMAP.
 */
model EmailRecipient {
  id      String @id @default(cuid())
  emailId String
  userId  Int // MySQL user id

  type RecipientType

  folder      EmailFolder @default(INBOX)
  isRead      Boolean     @default(false)
  isStarred   Boolean     @default(false)
  isImportant Boolean     @default(false)
  labels      String[]    @default([])

  deletedAt DateTime? // soft-delete into Trash; a cron can hard-delete after 30 days

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@unique([emailId, userId, type])
  @@index([userId, folder])
  @@index([userId, isRead])
  @@index([userId, isStarred])
}

enum RecipientType {
  TO
  CC
  BCC
  SENDER
}

enum EmailFolder {
  INBOX
  SENT
  DRAFTS
  SCHEDULED
  SPAM
  TRASH
  ARCHIVE
}

model EmailAttachment {
  id       String @id @default(cuid())
  emailId  String
  fileName String
  fileUrl  String
  fileSize Int
  mimeType String

  createdAt DateTime @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model EmailLabel {
  id     String @id @default(cuid())
  userId Int
  name   String
  color  String @default("#64748b")

  @@unique([userId, name])
  @@index([userId])
}

model EmailSignature {
  id      String @id @default(cuid())
  userId  Int    @unique
  content String @db.Text
  isAutoAppend Boolean @default(true)
}

